<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview before Android 12: the widget's shape and done marker, without text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#FFF8FAFC"/>
      <corners android:radius="16dp"/>
      <size android:width="130dp" android:height="64dp"/>
    </shape>
  </item>
  <item android:drawable="@drawable/hafiz_widget_marker_done" android:gravity="start|center_vertical" android:start="14dp" android:width="22dp" android:height="22dp"/>
</layer-list>
