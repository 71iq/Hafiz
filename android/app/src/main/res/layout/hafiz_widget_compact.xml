<?xml version="1.0" encoding="utf-8"?>
<!-- From 130 x 48 dp, a short 2 x 1: the flame and count at the start and Zayt filling the height at the
     end, with no line. Used only with Show Zayt on; without Zayt the strip's plain card takes this
     size. The renderer sets every color. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hafiz_widget_card"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:importantForAccessibility="noHideDescendants">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="18dp"
                android:layout_height="18dp">
                <ImageView
                    android:id="@+id/widget_flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/hafiz_widget_flame_unlit"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:id="@+id/widget_flame_motion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>
            </FrameLayout>
            <TextView
                android:id="@+id/widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="20sp"
                android:textColor="@color/hafiz_widget_accent_text"
                android:textAlignment="viewStart"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <!-- The line never shows here; the empty view keeps the renderer's ID. -->
        <TextView
            android:id="@+id/widget_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <!-- RemoteViews has no Space; an empty frame takes the free width. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <!-- Zayt follows the widget's height with only the twig tip and the feet cut, so the face, low on
             the drop, always shows. The inner frame wraps the still, and the empty pair makes FrameLayout
             measure the frame list at the still's own size. -->
        <FrameLayout
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="-10dp"
            android:layout_marginBottom="-6dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="noHideDescendants">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom">
                <ImageView
                    android:id="@+id/widget_zayt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="72dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:id="@+id/widget_motion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/widget_motion_pair"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
