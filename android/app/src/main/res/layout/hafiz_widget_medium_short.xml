<?xml version="1.0" encoding="utf-8"?>
<!-- 250 x 110 dp and up: Zayt beside the count row and headline. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hafiz_widget_bg"
        android:scaleType="fitXY"
        android:tint="@color/hafiz_widget_surface"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:importantForAccessibility="noHideDescendants">
        <ImageView
            android:id="@+id/widget_zayt"
            android:layout_width="48dp"
            android:layout_height="60dp"
            android:layout_marginEnd="12dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:src="@drawable/hafiz_widget_zayt_rest"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/widget_marker"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/hafiz_widget_marker_open"
                    android:tint="@color/hafiz_widget_accent"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/widget_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif"
                    android:textSize="28sp"
                    android:textColor="@color/hafiz_widget_accent_text"
                    android:textAlignment="viewStart"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="none"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:includeFontPadding="false"/>
                <TextView
                    android:id="@+id/widget_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif"
                    android:textSize="12sp"
                    android:textColor="@color/hafiz_widget_text_secondary"
                    android:textAlignment="viewStart"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="none"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textColor="@color/hafiz_widget_text_primary"
                android:textAlignment="viewStart"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
