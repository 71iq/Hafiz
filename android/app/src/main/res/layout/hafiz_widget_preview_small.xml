<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview from Android 12: a done day on the tile, with sample numbers and no personal data. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hafiz_widget_scene_radiant_sq"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:importantForAccessibility="noHideDescendants">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp">
                <ImageView
                    android:id="@+id/widget_flame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/hafiz_widget_flame_lit_t1"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:id="@+id/widget_flame_motion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>
            </FrameLayout>
            <TextView
                android:id="@+id/widget_count"
                android:text="@string/hafiz_widget_preview_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="26sp"
                android:textColor="#FF9A3412"
                android:textAlignment="viewStart"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/widget_line"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"
            android:textColor="@color/hafiz_widget_text_primary"
            android:textAlignment="center"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="none"
            android:ellipsize="end"
            android:maxLines="2"
            android:gravity="center"
            android:layout_marginTop="2dp"/>
        <FrameLayout
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="-22dp"
            android:importantForAccessibility="noHideDescendants">
            <!-- Wraps the still exactly, so a frame list in widget_motion gets the same box. FrameLayout
                 measures match_parent children again at its final size only when it has two or more, so the
                 empty widget_motion_pair is what stretches the frame list to the still. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal">
                <ImageView
                    android:id="@+id/widget_zayt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/hafiz_widget_zayt_shimmer"
                    android:maxWidth="240dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:id="@+id/widget_motion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/widget_motion_pair"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
