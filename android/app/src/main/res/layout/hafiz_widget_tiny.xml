<?xml version="1.0" encoding="utf-8"?>
<!-- Below 200 x 40 dp: the marker and the count, or the headline when there is no count. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hafiz_widget_bg"
        android:scaleType="fitXY"
        android:tint="@color/hafiz_widget_surface"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:importantForAccessibility="noHideDescendants">
        <ImageView
            android:id="@+id/widget_marker"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/hafiz_widget_marker_open"
            android:tint="@color/hafiz_widget_accent"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif"
            android:textSize="20sp"
            android:textColor="@color/hafiz_widget_accent_text"
            android:textAlignment="viewStart"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="none"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="1"
            android:textStyle="bold"
            android:includeFontPadding="false"/>
        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"
            android:textColor="@color/hafiz_widget_text_primary"
            android:textAlignment="viewStart"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="none"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="1"
            android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
