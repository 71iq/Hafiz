<?xml version="1.0" encoding="utf-8"?>
<!-- 250 x 130 dp to under 170 dp tall: hafiz_widget_wide made shorter so the week row still fits,
     with a smaller count and line.
     Shared by both modes. With Show Zayt on, widget_scene shows the sky and widget_art holds Zayt; the
     renderer sets every color. With it off, widget_scene is the theme card and widget_art is gone. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hafiz_widget_card"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:importantForAccessibility="noHideDescendants">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp">
                    <ImageView
                        android:id="@+id/widget_flame"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/hafiz_widget_flame_unlit"
                        android:importantForAccessibility="no"/>
                    <FrameLayout
                        android:id="@+id/widget_flame_motion"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"/>
                </FrameLayout>
                <TextView
                    android:id="@+id/widget_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textSize="30sp"
                    android:textColor="@color/hafiz_widget_accent_text"
                    android:textAlignment="viewStart"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="none"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/widget_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:textColor="@color/hafiz_widget_text_primary"
                android:textAlignment="viewStart"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:ellipsize="end"
                android:maxLines="2"
                android:layout_marginTop="4dp"/>
            <LinearLayout
                android:id="@+id/widget_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widget_week_label_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/hafiz_widget_text_secondary"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:id="@+id/widget_week_mark_0"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/hafiz_widget_day_empty"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widget_week_label_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/hafiz_widget_text_secondary"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:id="@+id/widget_week_mark_1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/hafiz_widget_day_empty"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widget_week_label_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/hafiz_widget_text_secondary"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:id="@+id/widget_week_mark_2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/hafiz_widget_day_empty"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widget_week_label_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/hafiz_widget_text_secondary"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:id="@+id/widget_week_mark_3"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/hafiz_widget_day_empty"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widget_week_label_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/hafiz_widget_text_secondary"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:id="@+id/widget_week_mark_4"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/hafiz_widget_day_empty"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widget_week_label_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/hafiz_widget_text_secondary"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:id="@+id/widget_week_mark_5"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/hafiz_widget_day_empty"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/widget_week_label_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="10sp"
                        android:textColor="@color/hafiz_widget_text_secondary"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                    <ImageView
                        android:id="@+id/widget_week_mark_6"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="3dp"
                        android:src="@drawable/hafiz_widget_day_empty"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="-8dp"
            android:importantForAccessibility="noHideDescendants">
            <!-- Wraps the still exactly, so a frame list in widget_motion gets the same box. FrameLayout
                 measures match_parent children again at its final size only when it has two or more, so the
                 empty widget_motion_pair is what stretches the frame list to the still. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal">
                <ImageView
                    android:id="@+id/widget_zayt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="112dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:id="@+id/widget_motion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/widget_motion_pair"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
