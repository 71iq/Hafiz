<?xml version="1.0" encoding="utf-8"?>
<!-- 320 x 170 dp and up: hafiz_widget_wide with Zayt up to 165 dp wide. Keep the two in step;
     tests/unit/widget-resources.test.ts checks that only the cap differs.
     Shared by both modes. With Show Zayt on, widget_scene shows the sky and widget_art holds Zayt; the
     renderer sets every color. With it off, widget_scene is the theme card and widget_art is gone. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="locale">
    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hafiz_widget_card"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:importantForAccessibility="noHideDescendants">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">
            <include layout="@layout/hafiz_widget_wide_count"/>
            <TextView
                android:id="@+id/widget_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"
                android:textColor="@color/hafiz_widget_text_primary"
                android:textAlignment="viewStart"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:ellipsize="end"
                android:maxLines="2"
                android:layout_marginTop="4dp"/>
            <include layout="@layout/hafiz_widget_week"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/widget_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="-8dp"
            android:importantForAccessibility="noHideDescendants">
            <!-- Wraps the still exactly, so a frame list in widget_motion gets the same box. FrameLayout
                 measures match_parent children again at its final size only when it has two or more, so the
                 empty widget_motion_pair is what stretches the frame list to the still. -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal">
                <ImageView
                    android:id="@+id/widget_zayt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxWidth="165dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:id="@+id/widget_motion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/widget_motion_pair"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
