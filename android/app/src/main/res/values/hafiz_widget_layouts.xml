<?xml version="1.0" encoding="utf-8"?>
<!-- A distinct layout ID forces reinflation when switching between fixed app colors and
     launcher-resolved day/night resources. Reapplying a view would keep its previous tint. -->
<resources>
    <item type="layout" name="hafiz_widget_tiny_system">@layout/hafiz_widget_tiny</item>
    <item type="layout" name="hafiz_widget_strip_system">@layout/hafiz_widget_strip</item>
    <item type="layout" name="hafiz_widget_compact_system">@layout/hafiz_widget_compact</item>
    <item type="layout" name="hafiz_widget_medium_short_system">@layout/hafiz_widget_medium_short</item>
    <item type="layout" name="hafiz_widget_medium_system">@layout/hafiz_widget_medium</item>
    <item type="layout" name="hafiz_widget_message_system">@layout/hafiz_widget_message</item>
</resources>
