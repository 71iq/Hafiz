# Import this file from the existing Caddyfile after validating both together.
(hafiz_static) {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  header Referrer-Policy strict-origin-when-cross-origin

  # Sideloaded Android releases, published by scripts/release-android.sh outside the web release
  # so website deploys never remove them. Versioned APKs never change; hafiz.apk and latest.json do.
  @downloads path /downloads/*
  handle @downloads {
    root * /opt/hafiz/public
    @apk path *.apk
    header @apk Content-Type application/vnd.android.package-archive
    header @apk Content-Disposition attachment
    @versioned_apk path_regexp ^/downloads/android/hafiz-[^/]+\.apk$
    header @versioned_apk Cache-Control "public, max-age=31536000, immutable"
    @mutable not path_regexp ^/downloads/android/hafiz-[^/]+\.apk$
    header @mutable Cache-Control "no-cache"
    file_server
  }

  # Android App Link verification for https://hafizquran.app/auth/qf-app-callback. The static
  # deploy rejects hidden paths, so Caddy serves the release certificate's digest here.
  handle /.well-known/assetlinks.json {
    header Content-Type application/json
    respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"com.anonymous.hafiz","sha256_cert_fingerprints":["37:4B:11:94:3C:7D:FB:6E:51:B9:5E:74:50:5E:B2:37:36:D5:3E:07:84:E8:CF:13:E7:1C:3F:AE:EE:C2:51:AC"]}}]` 200
  }

  handle {
    root * /opt/hafiz/current/dist
    header Cache-Control "no-cache"
    @versioned path /_expo/static/* /assets/*
    header @versioned Cache-Control "public, max-age=31536000, immutable"
    @profile path_regexp profile ^/profile/[^/]+/?$
    rewrite @profile /profile/[userId].html
    try_files {path} {path}.html {path}/index.html /+not-found.html
    file_server
  }
}

http://127.0.0.1:8081 {
  import hafiz_static
}

hafizquran.app, staging.hafizquran.app {
  import hafiz_static
}

www.hafizquran.app {
  redir https://hafizquran.app{uri} permanent
}

api.hafizquran.app {
  request_body {
    max_size 8MB
  }
  # The dashboard, metadata, pooler and database have no public route.
  # Only the Quran Foundation content function is public. qf-user stays closed until
  # Quran Foundation registers the Hafiz redirect URIs for its client.
  # Signup, password recovery and confirmation resend send email through Resend SMTP.
  # The app uses no other email flow, so the rest stay closed and cannot be used to send mail.
  @disabled_auth path /auth/v1/otp /auth/v1/magiclink /auth/v1/invite /auth/v1/reauthenticate
  handle @disabled_auth {
    header Content-Type application/json
    respond `{"code":"feature_disabled","msg":"This sign-in method is not available."}` 503
  }
  @client_api path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/qf-content
  handle @client_api {
    reverse_proxy 127.0.0.1:8100 {
      header_up -Cookie
    }
  }
  handle {
    respond 404
  }
}
