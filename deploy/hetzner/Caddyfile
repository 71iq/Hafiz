# Import this file from the existing Caddyfile after validating both together.
(hafiz_static) {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  header Referrer-Policy strict-origin-when-cross-origin

  # Sideloaded Android releases, published by scripts/release-android.sh outside the web release
  # so website deploys never remove them. Versioned APKs never change; hafiz.apk and latest.json do.
  @downloads path /downloads/*
  handle @downloads {
    root * /opt/hafiz/public
    @apk path *.apk
    header @apk Content-Type application/vnd.android.package-archive
    header @apk Content-Disposition attachment
    @versioned_apk path_regexp ^/downloads/android/hafiz-[^/]+\.apk$
    header @versioned_apk Cache-Control "public, max-age=31536000, immutable"
    @mutable not path_regexp ^/downloads/android/hafiz-[^/]+\.apk$
    header @mutable Cache-Control "no-cache"
    file_server
  }

  handle {
    root * /opt/hafiz/current/dist
    header Cache-Control "no-cache"
    @versioned path /_expo/static/* /assets/*
    header @versioned Cache-Control "public, max-age=31536000, immutable"
    @profile path_regexp profile ^/profile/[^/]+/?$
    rewrite @profile /profile/[userId].html
    try_files {path} {path}.html {path}/index.html /+not-found.html
    file_server
  }
}

http://127.0.0.1:8081 {
  import hafiz_static
}

hafizquran.app, staging.hafizquran.app {
  import hafiz_static
}

www.hafizquran.app {
  redir https://hafizquran.app{uri} permanent
}

api.hafizquran.app {
  request_body {
    max_size 8MB
  }
  # The dashboard, metadata, pooler and database have no public route.
  # Quran Foundation functions remain backed up but are temporarily disabled.
  # Email-dependent flows and new accounts are disabled until SMTP is configured.
  @disabled_auth path /auth/v1/signup /auth/v1/recover /auth/v1/resend /auth/v1/otp /auth/v1/magiclink /auth/v1/invite /auth/v1/reauthenticate
  handle @disabled_auth {
    header Content-Type application/json
    respond `{"code":"feature_disabled","msg":"Signup and password reset are temporarily unavailable."}` 503
  }
  @client_api path /auth/v1/* /rest/v1/* /storage/v1/*
  handle @client_api {
    reverse_proxy 127.0.0.1:8100 {
      header_up -Cookie
    }
  }
  handle {
    respond 404
  }
}
