{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": [
    "opencode-wakatime",
    "opencode-sessions",
    "@tarquinen/opencode-dcp"
  ],
  "lsp": true,
  "formatter": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sqlite", "./assets/data/quran.db"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "bash": {
      "npm run *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git add *": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "*": "ask"
    },
    "external_directory": {
      "~/code/Hafiz/**": "allow",
      "*": "ask"
    }
  },
  "tool_output": {
    "max_lines": 3000,
    "max_bytes": 102400
  },
  "compaction": {
    "tail_turns": 5,
    "auto": true
  }
}
