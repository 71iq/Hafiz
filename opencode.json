{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "plugin": ["opencode-wakatime", "opencode-sessions", "@tarquinen/opencode-dcp"],
  "lsp": true,
  "formatter": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "timeout": 30000
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "permission": {
    "bash": {
      "rm": "ask",
      "git push --force": "ask",
      "*": "allow"
    },
    "external_directory": {
      "~/code/Hafiz/**": "allow",
      "*": "ask"
    }
  },
  "tool_output": {
    "max_lines": 3000,
    "max_bytes": 102400
  },
  "compaction": {
    "tail_turns": 5,
    "auto": true
  }
}
