{
  "name": "hafiz",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://hafizquran.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/71iq/Hafiz.git"
  },
  "bugs": {
    "url": "https://github.com/71iq/Hafiz/issues"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "EXPO_NO_DEV_TOOLS=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:jest-config": "node --test --test-reporter=tap scripts/tests/jest-config.test.cjs",
    "test:dependency-security": "node --test --test-reporter=tap scripts/tests/brace-expansion.test.cjs scripts/tests/nanoid.test.cjs scripts/tests/js-yaml.test.cjs scripts/tests/xmldom.test.cjs scripts/tests/ws.test.cjs scripts/tests/source-map-js.test.cjs scripts/tests/tailwind-source-map.test.cjs",
    "test:metro-unicode": "node --test --test-reporter=tap scripts/tests/metro-unicode.test.cjs",
    "build:web:test": "npm run build:web",
    "test:e2e:smoke": "npm run build:web:test && playwright test --project=smoke-chromium tests/e2e/smoke.spec.ts",
    "test:ui:phase": "node scripts/run-ui-phase.mjs",
    "test:ui:rtl": "npm run build:web:test && playwright test --project=ui-390-chromium tests/e2e/report-only/rtl-ui-contract.spec.ts",
    "test:ui:baseline": "node scripts/run-ui-baseline.mjs",
    "verify:quick": "npm run typecheck && npm run test:unit && npm run test:e2e:smoke",
    "verify:web": "npm run typecheck && npm run build:web && npm run test:e2e:smoke",
    "validate:reflection-journey": "node --experimental-strip-types scripts/validate-reflection-journey.js",
    "build:db": "node scripts/build-quran-db.mjs",
    "build:web": "expo export --platform web",
    "prebuild:web": "bash scripts/prepare-web-data.sh",
    "postinstall": "node scripts/fix-rn-gradle-plugin.js && patch-package",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier . --write --ignore-unknown",
    "analyze:unused": "knip --reporter json",
    "analyze:duplicates": "jscpd --config .jscpd.json",
    "analyze:boundaries": "depcruise app components lib --config .dependency-cruiser.cjs --output-type json --no-ignore-known --no-cache",
    "diagnose:expo": "expo-doctor",
    "audit:dependencies": "npm audit --json",
    "format:check": "prettier . --check --ignore-unknown",
    "test:refactor-runner": "python3 -m unittest discover -s scripts/ralph/tests -v",
    "refactor:start": "python3 scripts/ralph/control.py start",
    "refactor:resume": "python3 scripts/ralph/control.py resume",
    "refactor:stop": "python3 scripts/ralph/control.py stop",
    "refactor:status": "python3 scripts/ralph/control.py status",
    "analyze:boundaries:android": "depcruise app components lib --config .dependency-cruiser.android.cjs --output-type json --no-ignore-known --no-cache",
    "analyze:boundaries:ios": "depcruise app components lib --config .dependency-cruiser.ios.cjs --output-type json --no-ignore-known --no-cache",
    "test:boundaries": "node --test --test-reporter=tap scripts/tests/dependency-boundaries.test.cjs",
    "check:boundaries:web": "depcruise app components lib --config .dependency-cruiser.cjs --output-type err --no-ignore-known --no-cache",
    "check:boundaries:android": "depcruise app components lib --config .dependency-cruiser.android.cjs --output-type err --no-ignore-known --no-cache",
    "check:boundaries:ios": "depcruise app components lib --config .dependency-cruiser.ios.cjs --output-type err --no-ignore-known --no-cache",
    "check:boundaries": "npm run check:boundaries:web && npm run check:boundaries:android && npm run check:boundaries:ios",
    "test:lint-coverage": "node --test --test-reporter=tap scripts/tests/lint-coverage.test.cjs",
    "check:native-config": "python3 -B scripts/check-native-config.py",
    "check:analysis": "node scripts/check-analysis-baseline.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/noto-serif": "^0.4.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.28",
    "@rive-app/react-native": "^0.4.6",
    "@rive-app/react-webgl2": "^4.28.5",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.95.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~55.0.32",
    "expo-application": "~55.0.19",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.41",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.18",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "lucide-react-native": "^0.575.0",
    "nativewind": "^4.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.72.0",
    "react-native": "0.83.10",
    "react-native-css-interop": "0.2.2",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "ts-fsrs": "^5.3.1",
    "zod": "4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "19.3.0",
    "babel-preset-expo": "~55.0.25",
    "dependency-cruiser": "18.6.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "55.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.4",
    "fast-check": "4.10.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-expo": "~55.0.22",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.4",
    "react-test-renderer": "^19.2.0",
    "sharp": "0.35.5",
    "supabase": "^2.98.2",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-devtools-core": {
      "shell-quote": "1.12.0"
    },
    "supabase": {
      "tar": "7.5.22"
    }
  }
}
