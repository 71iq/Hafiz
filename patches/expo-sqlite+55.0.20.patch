+async function retireIdleRuntime(): Promise<void> {
+  // SQLite close alone retains OPFS pool locks. Release them before host handoff,
+  // also when an asset import finishes without a subsequent open.
+  await _vfs?.close();
+  await _vfsMemory?.close();
+  _sqlite3 = null;
+  _vfs = null;
+  _vfsMemory = null;
+  statementIdMap.clear();
+  sessionIdMap.clear();
